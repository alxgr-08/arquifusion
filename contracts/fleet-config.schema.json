{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arquifusion/contracts/fleet-config.schema.json",
  "title": "FleetConfig",
  "description": "Demo fleet. Producer: Rol 2 (scripts/seed_demo.py writes it to DynamoDB and SSM). Consumers: simulator, fault-injector, incident-tasks (Rol 2), synthetic history (Rol 3).",
  "type": "object",
  "required": ["schemaVersion", "operationId", "referenceTime", "zones", "warehouses", "models", "machines", "technicians", "parts", "failureModes", "faultCatalog", "faultIntensity", "demo"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "metricName": { "enum": ["temperatureC", "vibrationMmS", "pressureBar", "fuelRateLph", "loadTons", "speedKmh", "rpm"] },
    "specialty": { "enum": ["HYDRAULIC", "MECHANICAL", "ENGINE", "ELECTRICAL"] },
    "stat": {
      "type": "object", "required": ["mean", "std"], "additionalProperties": false,
      "properties": { "mean": { "type": "number" }, "std": { "type": "number", "minimum": 0 } }
    }
  },
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "operationId": { "$ref": "#/$defs/id" },
    "referenceTime": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "zones": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["zoneId", "name", "lat", "lon", "radiusKm"], "additionalProperties": false,
        "properties": {
          "zoneId": { "$ref": "#/$defs/id" }, "name": { "type": "string" },
          "lat": { "$ref": "#/$defs/lat" }, "lon": { "$ref": "#/$defs/lon" }, "radiusKm": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "warehouses": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["warehouseId", "name", "lat", "lon"], "additionalProperties": false,
        "properties": {
          "warehouseId": { "$ref": "#/$defs/id" }, "name": { "type": "string" },
          "lat": { "$ref": "#/$defs/lat" }, "lon": { "$ref": "#/$defs/lon" }
        }
      }
    },
    "models": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["model", "machineType", "nominalLoadTons", "fuelTankL", "maintenanceIntervalHours", "costPerHourUsd", "metrics"],
        "additionalProperties": false,
        "properties": {
          "model": { "$ref": "#/$defs/id" },
          "machineType": { "enum": ["EXCAVATOR", "HAUL_TRUCK", "LOADER", "BULLDOZER", "DRILL", "GRADER", "CRANE", "TRACTOR", "GENERATOR"] },
          "nominalLoadTons": { "type": "number", "minimum": 0 },
          "fuelTankL": { "type": "number", "exclusiveMinimum": 0 },
          "maintenanceIntervalHours": { "type": "number", "exclusiveMinimum": 0 },
          "costPerHourUsd": { "type": "number", "minimum": 0 },
          "metrics": {
            "type": "object", "additionalProperties": false,
            "required": ["temperatureC", "vibrationMmS", "pressureBar", "fuelRateLph", "loadTons", "speedKmh", "rpm"],
            "patternProperties": { "^[a-zA-Z]+$": { "$ref": "#/$defs/stat" } }
          }
        }
      }
    },
    "machines": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["machineId", "model", "zoneId", "engineHours", "lastMaintenanceHours", "utilization", "fuelBatchId"],
        "additionalProperties": false,
        "properties": {
          "machineId": { "type": "string", "pattern": "^[A-Z]{2,5}-[0-9]{4}$" },
          "model": { "$ref": "#/$defs/id" }, "zoneId": { "$ref": "#/$defs/id" },
          "engineHours": { "type": "number", "minimum": 0 },
          "lastMaintenanceHours": { "type": "number", "minimum": 0 },
          "utilization": { "type": "number", "minimum": 0, "maximum": 1 },
          "fuelBatchId": { "$ref": "#/$defs/id" }
        }
      }
    },
    "technicians": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["techId", "name", "specialties", "lat", "lon"], "additionalProperties": false,
        "properties": {
          "techId": { "type": "string", "pattern": "^T-[0-9]{2}$" }, "name": { "type": "string" },
          "specialties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/specialty" } },
          "lat": { "$ref": "#/$defs/lat" }, "lon": { "$ref": "#/$defs/lon" }
        }
      }
    },
    "parts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["partId", "name", "unitCostUsd", "leadTimeDays", "stock"], "additionalProperties": false,
        "properties": {
          "partId": { "$ref": "#/$defs/id" }, "name": { "type": "string" },
          "unitCostUsd": { "type": "number", "minimum": 0 }, "leadTimeDays": { "type": "integer", "minimum": 0 },
          "stock": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "failureModes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["mode", "label", "metrics", "specialty", "parts"], "additionalProperties": false,
        "properties": {
          "mode": { "type": "string" }, "label": { "type": "string" },
          "metrics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/metricName" } },
          "specialty": { "$ref": "#/$defs/specialty" },
          "parts": {
            "type": "array",
            "items": {
              "type": "object", "required": ["partId", "qty"], "additionalProperties": false,
              "properties": { "partId": { "$ref": "#/$defs/id" }, "qty": { "type": "integer", "minimum": 1 } }
            }
          }
        }
      }
    },
    "faultCatalog": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "sigma": { "type": "object", "additionalProperties": { "type": "number" } },
          "nullMetrics": { "type": "array", "items": { "$ref": "#/$defs/metricName" } },
          "status": { "enum": ["OPERATING", "IDLE", "STOPPED", "MAINTENANCE"] },
          "fuelBatchId": { "$ref": "#/$defs/id" }
        }
      }
    },
    "faultIntensity": {
      "type": "object", "required": ["WARNING", "CRITICAL"], "additionalProperties": false,
      "properties": { "WARNING": { "type": "number", "exclusiveMinimum": 0 }, "CRITICAL": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "demo": {
      "type": "object", "required": ["fastIntervalSeconds", "rampSeconds"], "additionalProperties": false,
      "properties": {
        "fastIntervalSeconds": { "type": "integer", "minimum": 5, "maximum": 60 },
        "rampSeconds": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
