{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arquifusion/contracts/anomaly-detected.schema.json",
  "title": "AnomalyDetected",
  "description": "EventBridge event. Producer: health-evaluator (Rol 3). Consumer: incident Step Function (Rol 2). Only WARNING and CRITICAL start the Step Function.",
  "type": "object",
  "required": ["source", "detail-type", "detail"],
  "properties": {
    "source": { "const": "arquifusion.health" },
    "detail-type": { "const": "AnomalyDetected" },
    "detail": {
      "type": "object",
      "required": ["schemaVersion", "machineId", "operationId", "zoneId", "model", "detectedAt", "healthScore", "severity", "signals", "comparedAgainst"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "machineId": { "type": "string" },
        "operationId": { "type": "string" },
        "zoneId": { "type": "string" },
        "model": { "type": "string" },
        "detectedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "healthScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "severity": { "enum": ["OK", "WATCH", "WARNING", "CRITICAL"] },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["metric", "value", "baseline", "zScore", "trend"],
            "additionalProperties": false,
            "properties": {
              "metric": { "type": "string" },
              "value": { "type": "number" },
              "baseline": { "type": "number" },
              "zScore": { "type": "number" },
              "trend": { "enum": ["RISING", "FALLING", "STABLE"] }
            }
          }
        },
        "comparedAgainst": {
          "type": "array",
          "items": { "enum": ["OWN_HISTORY", "MODEL_FLEET"] },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
