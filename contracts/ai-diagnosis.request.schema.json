{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arquifusion/contracts/ai-diagnosis.request.schema.json",
  "title": "AiDiagnosisRequest",
  "description": "Incident Step Function (Rol 2) -> af-dev-ai-diagnosis (Rol 3). PROPOSAL v1.0, pending approval by the three.",
  "type": "object",
  "required": ["schemaVersion", "incidentId", "anomaly", "machine", "history", "zone", "candidateFailureModes"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "incidentId": { "type": "string", "pattern": "^INC-[0-9a-f]{4,}$" },
    "anomaly": { "description": "The 'detail' of AnomalyDetected, unchanged", "type": "object", "required": ["machineId", "severity", "signals"] },
    "machine": {
      "type": "object",
      "required": ["machineId", "model", "machineType", "zoneId"],
      "properties": {
        "machineId": { "type": "string" }, "model": { "type": "string" }, "machineType": { "type": "string" },
        "zoneId": { "type": "string" }, "engineHours": { "type": ["number", "null"] },
        "lastMaintenanceHours": { "type": ["number", "null"] }, "fuelBatchId": { "type": ["string", "null"] }
      }
    },
    "history": {
      "type": "object",
      "required": ["incidents", "maintenance"],
      "properties": {
        "incidents": { "type": "array", "description": "Last incidents of the machine, newest first", "items": { "type": "object" } },
        "maintenance": { "type": "array", "description": "Last maintenance records, newest first", "items": { "type": "object" } }
      }
    },
    "zone": {
      "type": "object",
      "required": ["zoneId", "windowMinutes", "machines"],
      "properties": {
        "zoneId": { "type": "string" }, "windowMinutes": { "type": "integer" },
        "machines": {
          "type": "array",
          "description": "Other machines with incidents in the same zone inside the window",
          "items": {
            "type": "object", "required": ["machineId", "incidentId"],
            "properties": {
              "machineId": { "type": "string" }, "incidentId": { "type": "string" }, "model": { "type": "string" },
              "failureMode": { "type": ["string", "null"] }, "fuelBatchId": { "type": ["string", "null"] },
              "createdAt": { "type": "string" }
            }
          }
        }
      }
    },
    "candidateFailureModes": {
      "type": "array",
      "description": "Known failure modes; pick one (or UNKNOWN) so parts and specialty stay consistent",
      "items": { "type": "object", "required": ["mode", "label", "metrics", "specialty", "parts"] }
    }
  }
}
