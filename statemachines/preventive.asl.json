{
  "Comment": "af-dev-preventive (P2, P3). Trigger: EventBridge Scheduler daily with input {\"operationId\": \"MINA-NORTE\"}. Owner: Rol 2",
  "StartAt": "LoadMachines",
  "States": {
    "LoadMachines": {
      "Type": "Task",
      "Resource": "${incident_tasks_arn}",
      "Parameters": {
        "action": "load_machines",
        "operationId.$": "$.operationId"
      },
      "ResultPath": "$.load",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "ClientError"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "ForEachMachine"
    },
    "ForEachMachine": {
      "Type": "Map",
      "ItemsPath": "$.load.machines",
      "ItemSelector": {
        "machine.$": "$$.Map.Item.Value",
        "operationId.$": "$.operationId"
      },
      "MaxConcurrency": 20,
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "ComputeDueHours",
        "States": {
          "ComputeDueHours": {
            "Comment": "effective interval = base / usage factor (1.0 - 1.5)",
            "Type": "Task",
            "Resource": "${incident_tasks_arn}",
            "Parameters": {
              "action": "compute_due",
              "machine.$": "$.machine",
              "operationId.$": "$.operationId"
            },
            "ResultPath": "$.due",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException",
                  "ClientError"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "IsDue"
          },
          "IsDue": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.due.isDue",
                "BooleanEquals": true,
                "Next": "CreateMaintenanceOrder"
              }
            ],
            "Default": "NotDue"
          },
          "CreateMaintenanceOrder": {
            "Type": "Task",
            "Resource": "${incident_tasks_arn}",
            "Parameters": {
              "action": "create_maintenance_order",
              "due.$": "$.due"
            },
            "ResultPath": "$.order",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException",
                  "ClientError"
                ],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "Next": "CheckPartsAvailability"
          },
          "CheckPartsAvailability": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.order.partsOk",
                "BooleanEquals": true,
                "Next": "OrderReady"
              }
            ],
            "Default": "OrderWaitingParts"
          },
          "OrderReady": {
            "Type": "Pass",
            "Parameters": {
              "machineId.$": "$.machine.machineId",
              "order.$": "$.order"
            },
            "End": true
          },
          "OrderWaitingParts": {
            "Type": "Pass",
            "Parameters": {
              "machineId.$": "$.machine.machineId",
              "order.$": "$.order"
            },
            "End": true
          },
          "NotDue": {
            "Type": "Pass",
            "Parameters": {
              "machineId.$": "$.machine.machineId",
              "remainingHours.$": "$.due.remainingHours"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.results",
      "Next": "ReorderPartsIfNeeded"
    },
    "ReorderPartsIfNeeded": {
      "Comment": "Groups orders by zone; compares stock with the BigQuery forecast",
      "Type": "Task",
      "Resource": "${incident_tasks_arn}",
      "Parameters": {
        "action": "plan_restock",
        "results.$": "$.results"
      },
      "ResultPath": "$.plan",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "ClientError"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "SendDailySummary"
    },
    "SendDailySummary": {
      "Comment": "Maintenance lead + management",
      "Type": "Task",
      "Resource": "${notify_arn}",
      "Parameters": {
        "kind": "DAILY_SUMMARY",
        "summary.$": "$.plan.summary"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "ClientError"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    }
  }
}
